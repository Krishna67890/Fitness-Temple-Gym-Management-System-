# ============================================================
# FITNESS TEMPLE GYM — .gitignore
# ============================================================

# ---- Next.js Build Artifacts ----
.next/
out/
build/
dist/

# ---- Environment & Secrets (NEVER commit these) ----
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production
.env*.local

# ---- Firebase Admin Credentials (CRITICAL — never commit) ----
firebase-admin-sdk.json
serviceAccountKey.json
*-firebase-adminsdk-*.json
firebase_credentials.json
google-services.json
GoogleService-Info.plist

# ---- Dependencies ----
node_modules/
.pnp/
.pnp.js

# ---- IDEs & Editors ----
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ---- Logs ----
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# ---- AI & Tooling ----
.claude
.claude/
.aiexclude
.agents/
.gemini/

# ---- Deployment ----
.vercel/
.vercel
.netlify/

# ---- TypeScript ----
*.tsbuildinfo
tsconfig.tsbuildinfo

# ---- Testing ----
/coverage
.nyc_output

# ---- Misc ----
*.pem
*.key
*.cert
*.p12
*.pfx
.cache/
tmp/
temp/
