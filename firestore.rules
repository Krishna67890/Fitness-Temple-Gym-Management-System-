rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. REVIEWS: Open for all (Read & Write)
    match /reviews/{docId} {
      allow read, write: if true;
    }

    // 2. MEMBERS: Open for all (to allow registration/review updates)
    match /members/{docId} {
      allow read, write: if true;
    }

    // 3. SECURE FALLBACK: All other data requires authentication
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}