rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isOwner() {
      return isAuthenticated() && (
        (request.auth.token.email != null && (
          request.auth.token.email.lower() == 'management@fitnesstemple.com' ||
          request.auth.token.email.lower().matches('.*krishna.*') ||
          request.auth.token.email.lower().matches('.*patil.*') ||
          request.auth.token.email.lower().matches('.*sanket.*')
        )) || (userExists() && getUserData().role == 'owner')
      );
    }

    function isTrainer() {
      return isAuthenticated() && userExists() && getUserData().role == 'trainer';
    }

    function isAssignedTrainer(memberId) {
      return isTrainer() && (
        (resource != null && resource.data.trainerId == request.auth.uid) ||
        (request.resource != null && request.resource.data.trainerId == request.auth.uid) ||
        (exists(/databases/$(database)/documents/members/$(memberId)) &&
         get(/databases/$(database)/documents/members/$(memberId)).data.trainerId == request.auth.uid)
      );
    }

    // User authentication profile
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isOwner() || isTrainer());
      allow write: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner() || (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));
      allow delete: if isOwner();
    }

    // Member records
    match /members/{memberId} {
      allow read, write: if isAuthenticated() && request.auth.uid == memberId;
      allow read, write: if isOwner() || isAssignedTrainer(memberId);
    }

    // Workouts, Diets, Progress
    match /workouts/{memberId}/{allPaths=**} {
      allow read, write: if isAuthenticated() && (request.auth.uid == memberId || isAssignedTrainer(memberId) || isOwner());
    }
    match /diets/{memberId}/{allPaths=**} {
      allow read, write: if isAuthenticated() && (request.auth.uid == memberId || isAssignedTrainer(memberId) || isOwner());
    }
    match /progress/{memberId}/{allPaths=**} {
      allow read, write: if isAuthenticated() && (request.auth.uid == memberId || isAssignedTrainer(memberId) || isOwner());
    }

    // Attendance
    match /attendance/{memberId}/{allPaths=**} {
      allow read: if isAuthenticated() && (request.auth.uid == memberId || isTrainer() || isOwner());
      allow write: if isTrainer() || isOwner() || (isAuthenticated() && request.auth.uid == memberId);
    }

    // Trainer profiles
    match /trainers/{trainerId} {
      allow read: if isAuthenticated();
      allow write: if isOwner() || (isAuthenticated() && request.auth.uid == trainerId);
    }

    // Notifications
    match /notifications/{userId}/{notifId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow write: if isOwner() || isTrainer() || (isAuthenticated() && request.auth.uid == userId);
    }

    // Reviews - Truly public read and create for guests
    match /reviews/{reviewId} {
      allow read, create: if true;
      allow update: if isOwner() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow delete: if isOwner();
    }

    // Allow collection listing for published reviews
    match /reviews {
      allow read: if true;
    }
  }
}
