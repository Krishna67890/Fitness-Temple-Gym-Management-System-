rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Safer role checks that don't fail if doc doesn't exist
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isOwner() {
      return isAuthenticated() && (
        (userExists() && getUserData().role == 'owner') ||
        (request.auth.token.email != null && (
          request.auth.token.email.lower() == 'management@fitnesstemple.com' ||
          request.auth.token.email.lower().matches('.*krishna.*') ||
          request.auth.token.email.lower().matches('.*patil.*') ||
          request.auth.token.email.lower().matches('.*sanket.*')
        ))
      );
    }

    function isTrainer() {
      return isAuthenticated() && userExists() && getUserData().role == 'trainer';
    }

    function isAssignedTrainer(memberId) {
      return isTrainer() && (
        (resource != null && resource.data.trainerId == request.auth.uid) ||
        (request.resource != null && request.resource.data.trainerId == request.auth.uid) ||
        (exists(/databases/$(database)/documents/members/$(memberId)) &&
         get(/databases/$(database)/documents/members/$(memberId)).data.trainerId == request.auth.uid)
      );
    }

    // User authentication profile
    match /users/{userId} {
      // Allow user to read/write their own document - simplified for initial sync
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // Allow owners and trainers to see profiles
      allow read: if isOwner() || isTrainer();
      // Only owners can change roles or delete users
      allow update: if isOwner() || (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));
      allow delete: if isOwner();
    }

    // Member records
    match /members/{memberId} {
      allow read, write: if isAuthenticated() && request.auth.uid == memberId;
      allow read, write: if isOwner() || isAssignedTrainer(memberId);
    }

    // Workouts, Diets, Progress - consistent access for user, trainer, owner
    match /workouts/{memberId}/{allPaths=**} {
      allow read, write: if isAuthenticated() && (request.auth.uid == memberId || isAssignedTrainer(memberId) || isOwner());
    }
    match /diets/{memberId}/{allPaths=**} {
      allow read, write: if isAuthenticated() && (request.auth.uid == memberId || isAssignedTrainer(memberId) || isOwner());
    }
    match /progress/{memberId}/{allPaths=**} {
      allow read, write: if isAuthenticated() && (request.auth.uid == memberId || isAssignedTrainer(memberId) || isOwner());
    }

    // Attendance
    match /attendance/{memberId}/{allPaths=**} {
      allow read: if isAuthenticated() && (request.auth.uid == memberId || isTrainer() || isOwner());
      allow write: if isTrainer() || isOwner() || (isAuthenticated() && request.auth.uid == memberId);
    }

    // Trainer profiles
    match /trainers/{trainerId} {
      allow read: if isAuthenticated();
      allow write: if isOwner() || (isAuthenticated() && request.auth.uid == trainerId);
    }

    // Notifications
    match /notifications/{userId}/{notifId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow write: if isOwner() || isTrainer() || (isAuthenticated() && request.auth.uid == userId);
    }

    // Reviews
    match /reviews/{reviewId} {
      // Allow public reading of published reviews
      allow read: if resource == null || resource.data.status == 'published' ||
                   (isAuthenticated() && (request.auth.uid == resource.data.userId || isOwner()));
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow update, delete: if isAuthenticated() && (request.auth.uid == resource.data.userId || isOwner());
    }

    // Advanced Workout Engine & Wearables
    match /workout_plans/{planId} {
      allow read: if isAuthenticated();
      allow write: if isOwner() || isTrainer();
    }
    match /user_workouts/{userId}/{allPaths=**} {
      allow read, write: if isAuthenticated() && (request.auth.uid == userId || isOwner() || isTrainer());
    }
    match /wearable_sync/{userId}/{allPaths=**} {
      allow read, write: if isAuthenticated() && (request.auth.uid == userId || isOwner());
    }
  }
}